{
  "name":"photocard-studio","productName":"PhotoCard Studio","version":"1.6.0",
  "description":"PhotoCard Studio News Edition v1.6 — AI Search, Gemini, Resizable Shapes",
  "main":"main.js","author":"Abdullah Al Fahim","license":"MIT",
  "scripts":{"build":"npx webpack --mode production","dist":"npm run build && npx electron-builder --win --x64"},
  "dependencies":{"html2canvas":"^1.4.1","react":"^18.2.0","react-dom":"^18.2.0"},
  "devDependencies":{"@babel/core":"^7.23.0","@babel/preset-env":"^7.23.0","@babel/preset-react":"^7.22.0","babel-loader":"^9.1.3","electron":"^28.0.0","electron-builder":"^24.9.0","webpack":"^5.89.0","webpack-cli":"^5.1.4"},
  "build":{
    "appId":"com.abdullahalfahim.photocard-studio","productName":"PhotoCard Studio",
    "copyright":"© 2025 Abdullah Al Fahim",
    "directories":{"output":"release"},
    "files":["dist/**/*","public/**/*","main.js","preload.js"],
    "win":{"target":[{"target":"nsis","arch":["x64"]},{"target":"portable","arch":["x64"]}],"icon":"public/assets/icon.ico"},
    "nsis":{"oneClick":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true,"shortcutName":"PhotoCard Studio"}
  }
}
