{
  "name": "photocard-studio",
  "productName": "PhotoCard Studio",
  "version": "2.0.0",
  "description": "PhotoCard Studio 2 — a Figma-style editor for news photocards (Bangla & English)",
  "main": "main.js",
  "author": "Abdullah Al Fahim",
  "license": "MIT",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "konva": "^9.3.16",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "build": {
    "appId": "com.abdullahalfahim.photocard-studio",
    "productName": "PhotoCard Studio",
    "copyright": "© 2025 Abdullah Al Fahim",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PhotoCard Studio",
      "artifactName": "PhotoCard-Studio-Setup.${ext}"
    },
    "portable": {
      "artifactName": "PhotoCard-Studio-Portable.${ext}"
    }
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ]
    ]
  },
  "browserslist": [
    "last 2 Chrome versions"
  ]
}
